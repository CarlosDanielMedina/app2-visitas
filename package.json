{
  "name": "app2-visitas",
  "version": "1.0.0",
  "private": true,
  "description": "App 2 - Libro de Visitas (MERN) para práctica de proxy inverso con Nginx",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "nodemon --watch api --watch lib --watch server server/dev.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "nodemon": "^3.1.9",
    "vite": "^6.0.11"
  }
}
